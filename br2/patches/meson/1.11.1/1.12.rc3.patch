diff -urN "meson-1.11.1/test cases/common/289 importstd/meson.build" "meson-1.12.0rc3/test cases/common/289 importstd/meson.build"
--- "meson-1.11.1/test cases/common/289 importstd/meson.build"	1970-01-01 02:00:00.000000000 +0200
+++ "meson-1.12.0rc3/test cases/common/289 importstd/meson.build"	2026-08-04 18:56:32.000000000 +0300
@@ -0,0 +1,29 @@
+project('importstd', 'cpp', default_options: {'cpp_importstd': 'true',
+                                              'cpp_std': 'c++latest,c++23,c++20'})
+
+cpp = meson.get_compiler('cpp')
+
+cpp_id = cpp.get_id()
+cpp_version = cpp.version()
+is_windows = host_machine.system() == 'windows'
+
+# gcc 16 on Windows fails with "undefined reference to 'std::__open_terminal(_iobuf*)'"
+# clang 22 + mingw-w64 on Windows fails with "fatal error: module 'std' not found"
+if not is_windows and cpp_id == 'gcc' and cpp_version.version_compare('>=15.3')
+  # Versions between 15.0 and 15.2 are too unreliable to test.
+  # The same version number of GCC works in some distros
+  # but fails in others.
+  istd_supported = true
+elif cpp_id == 'msvc' and cpp_version.version_compare('>=19.44.35219')
+  istd_supported = get_option('backend') == 'ninja'
+else
+  istd_supported = false
+endif
+
+if istd_supported
+  useistd = executable('useistd', 'useistd.cpp')
+  test('useistd', useistd)
+
+else
+  message('Compiler not yet supported, import std test not run.')
+endif
